[Unit]
Description=sapphire-agent dispatcher (Linear epics to T3 Code threads)

[Service]
Type=simple
WorkingDirectory=%h/sapphire-agent
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v24.21.0/bin/node src/main.ts
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
